{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/cmsms_doctor/azhar-rashid", "destination": "/team/azhar-rashid/", "permanent": true },
    { "source": "/cmsms_doctor/mujahid-anwar-khan", "destination": "/team/mujahid-anwar-khan/", "permanent": true },
    { "source": "/cmsms_doctor/aamir-masood", "destination": "/team/aamir-masood/", "permanent": true },
    { "source": "/cmsms_doctor/dr-mowadat-hussain-rana", "destination": "/team/mowadat-hussain-rana/", "permanent": true },
    { "source": "/cmsms_doctor/ather-imran", "destination": "/team/ather-imran-nawaz/", "permanent": true },
    { "source": "/cmsms_doctor/dr-iram-aamir", "destination": "/team/iram-aamir/", "permanent": true },
    { "source": "/cmsms_doctor/:path*", "destination": "/about-us/#board", "permanent": true },
    { "source": "/wp-content/uploads/2026/09/OeR-Aug-Newsletter.pdf", "destination": "/assets/docs/omer-e-rawan-newsletter-august-2026.pdf", "permanent": true },
    { "source": "/wp-content/uploads/2025/12/OER-Audited-Account-2025.pdf", "destination": "/assets/docs/omer-e-rawan-audited-accounts-2025.pdf", "permanent": true },
    { "source": "/wp-content/uploads/2025/09/Health-and-Wellness-Initiative.pdf", "destination": "/assets/docs/omer-e-rawan-health-wellness-initiative.pdf", "permanent": true },
    { "source": "/gallery", "destination": "/previous-events/", "permanent": true },
    { "source": "/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/comments/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-json/:path*", "destination": "/", "permanent": true },
    { "source": "/xmlrpc.php", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/docs/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(favicon.ico|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
