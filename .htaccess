# Omer-e-Rawan Foundation — Apache configuration
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the non-www domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://omererawan.org%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs -> new pages (keeps existing search rankings)
  RewriteRule ^cmsms_doctor/azhar-rashid/?$ /team/azhar-rashid/ [L,R=301]
  RewriteRule ^cmsms_doctor/mujahid-anwar-khan/?$ /team/mujahid-anwar-khan/ [L,R=301]
  RewriteRule ^cmsms_doctor/aamir-masood/?$ /team/aamir-masood/ [L,R=301]
  RewriteRule ^cmsms_doctor/dr-mowadat-hussain-rana/?$ /team/mowadat-hussain-rana/ [L,R=301]
  RewriteRule ^cmsms_doctor/ather-imran/?$ /team/ather-imran-nawaz/ [L,R=301]
  RewriteRule ^cmsms_doctor/dr-iram-aamir/?$ /team/iram-aamir/ [L,R=301]
  RewriteRule ^wp-content/uploads/2026/09/OeR-Aug-Newsletter\.pdf$ /assets/docs/omer-e-rawan-newsletter-august-2026.pdf [L,R=301]
  RewriteRule ^wp-content/uploads/2025/12/OER-Audited-Account-2025\.pdf$ /assets/docs/omer-e-rawan-audited-accounts-2025.pdf [L,R=301]
  RewriteRule ^wp-content/uploads/2025/09/Health-and-Wellness-Initiative\.pdf$ /assets/docs/omer-e-rawan-health-wellness-initiative.pdf [L,R=301]
  RewriteRule ^(feed|comments/feed|wp-json|xmlrpc\.php)(/.*)?$ / [L,R=301]

  # Add trailing slash to directory URLs
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
